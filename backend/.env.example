# Node environment: development or production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/hirereach?schema=public

# Secret used to sign session JWTs. Use a long random string.
JWT_SECRET=replace_with_a_long_random_secret

# Public base URL of this backend
BACKEND_URL=http://localhost:4000

# Google OAuth 2.0 credentials (from Google Cloud Console).
# The same client is used for login and Gmail sending. In Google Cloud Console
# add BOTH redirect URIs below, and enable the Gmail API for the project.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Gmail OAuth callback (separate flow, gmail.send scope only)
GMAIL_CALLBACK_URL=http://localhost:4000/api/gmail/callback

# Key to encrypt stored Gmail OAuth tokens (AES-256-GCM).
# Must be 32 bytes: 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_hex_char_encryption_key

# Max emails a user can send per day (default 30)
DAILY_EMAIL_LIMIT=30

# Web search provider API key (Serper.dev - https://serper.dev).
# Used for HR discovery search. Leave empty to disable web search.
SEARCH_API_KEY=your_serper_api_key

# Grok (xAI) API for personalized email generation - https://x.ai/api
GROK_API_KEY=your_grok_api_key
# Optional overrides (defaults shown):
# GROK_API_URL=https://api.x.ai/v1
# GROK_MODEL=grok-3-mini
