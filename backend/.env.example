# Node environment: development or production
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/hirereach?schema=public

# Secret used to sign session JWTs. Use a long random string.
JWT_SECRET=replace_with_a_long_random_secret

# Google OAuth 2.0 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Web search provider API key (Serper.dev - https://serper.dev).
# Used for HR discovery search. Leave empty to disable web search.
SEARCH_API_KEY=your_serper_api_key

# Grok (xAI) API for personalized email generation - https://x.ai/api
GROK_API_KEY=your_grok_api_key
# Optional overrides (defaults shown):
# GROK_API_URL=https://api.x.ai/v1
# GROK_MODEL=grok-3-mini
